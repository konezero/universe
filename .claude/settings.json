{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -m tools.universe_session_inject_hook --repo-root . --provider CLAUDE --from-stdin --trigger session_start"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/konezero/.pyenv/pyenv-win/versions/3.14.5/python.exe C:/workspace/universe/tools/universe_host_turn_hook.py --provider CLAUDE",
            "timeout": 3
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/konezero/.pyenv/pyenv-win/versions/3.14.5/python.exe C:/workspace/universe/tools/universe_host_turn_hook.py --provider CLAUDE",
            "timeout": 3
          }
        ],
        "matcher": "idle_prompt|permission_prompt|elicitation_dialog|elicitation_url_dialog"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/konezero/.pyenv/pyenv-win/versions/3.14.5/python.exe C:/workspace/universe/tools/universe_host_turn_hook.py --provider CLAUDE",
            "timeout": 3
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/konezero/.pyenv/pyenv-win/versions/3.14.5/python.exe C:/workspace/universe/tools/universe_host_turn_hook.py --provider CLAUDE",
            "timeout": 3
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "C:/Users/konezero/.pyenv/pyenv-win/versions/3.14.5/python.exe C:/workspace/universe/tools/universe_host_turn_hook.py --provider CLAUDE",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
