{
  "schema": "universe.grok-cli-runtime-adapter.v2",
  "adapter_id": "universe-runtime-host-grok-cli-read-only",
  "entrypoint": "tools/universe_runtime_worker_dispatch.py",
  "transport": {
    "kind": "python-native-process",
    "native_cli_contract": "universe.windows-native-cli.v1",
    "shell": false,
    "argument_transport": "explicit-argv-array",
    "prompt_transport": "utf8-file",
    "input_schema": "universe.grok-worker-request.v1",
    "output_schema": "universe.grok-worker-result.v1",
    "context_source": "caller-supplied-context-pack-only",
    "stdout": "bounded-json-result",
    "hidden_reasoning": "excluded"
  },
  "runtime_provider": {
    "kind": "task-frame-agent-runtime",
    "profiles": {
      "READ_ONLY": {
        "execution": "BOUNDED_ANALYSIS",
        "repository_write_scope": "NONE"
      },
      "TASK_FRAME_RUNTIME": {
        "execution": "BOUNDED_TASK_FRAME_TURN",
        "repository_write_scope": "NONE",
        "source_mutation": "HOST_GATEWAY_ONLY"
      }
    },
    "external_tool_execution": "HOST_CAPABILITY_REQUIRED"
  },
  "worker_policy": {
    "repository_write_scope": "NONE",
    "mutation_scope": "EMPTY_REQUIRED",
    "permission_mode": "plan",
    "sandbox_profile": "read-only",
    "subagents": "FORBIDDEN",
    "memory": "DISABLED",
    "web_search": "DISABLED"
  },
  "task_frame": {
    "worker_invocation": "HOST_PROVIDED",
    "worker_actor": "grok-cli:<session_id>",
    "worker_run_ref": "universe-runtime-host:<call_id>",
    "result_receipt_ref": "grok-cli:<session_id>:<request_id>",
    "parent_adoption": "FORBIDDEN"
  }
}
